@model BeFit.Dtos.ExerciseFormDto

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Exercise</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" class="form-control" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumOfReps" class="control-label"></label>
                <input asp-for="NumOfReps" class="form-control" />
                <span asp-validation-for="NumOfReps" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumOfSeries" class="control-label"></label>
                <input asp-for="NumOfSeries" class="form-control" />
                <span asp-validation-for="NumOfSeries" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExerciseTypeId" class="label"></label>
                <select asp-for="ExerciseTypeId" class="input" asp-items="ViewBag.ExerciseTypeId"></select>
            </div>

            <div class="form-group">
                <label asp-for="SessionId" class="label"></label>
                <select asp-for="SessionId" class="input" asp-items="ViewBag.SessionId"></select>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
